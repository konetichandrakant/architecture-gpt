APP_NAME=Architecture GPT API
DEBUG=True
FRONTEND_URL=http://localhost:5173

# database (defaults to local sqlite)
DATABASE_URL=sqlite:///./architecture_gpt.db

# auth
JWT_SECRET=change-me

# critic loop: regenerate the diagram until the review score reaches the
# target (or max iterations); 80 is the default quality bar
GENERATION_QUALITY_TARGET=80
GENERATION_MAX_ITERATIONS=2

# provider api keys - litellm picks these up automatically; only the
# providers you actually route to need a key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# model routing overrides (comma separated litellm model ids,
# first entry preferred, the rest are cross-provider failovers)
LLM_ARCHITECTURE_MODELS=anthropic/claude-sonnet-5,openai/gpt-5.1,gemini/gemini-3-pro,xai/grok-4
LLM_CRITIQUE_MODELS=openai/gpt-5.1,anthropic/claude-opus-5,gemini/gemini-3-pro
LLM_ROADMAP_MODELS=gemini/gemini-3-pro,anthropic/claude-sonnet-5,deepseek/deepseek-chat
LLM_COSTS_MODELS=openai/gpt-5.1,deepseek/deepseek-chat,gemini/gemini-3-pro
LLM_EDIT_MODELS=anthropic/claude-sonnet-5,openai/gpt-5.1,xai/grok-4
